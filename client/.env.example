# Client (Vite) environment variables.
# Local dev: copy to client/.env and fill in.
# Vercel: set these under Project Settings → Environment Variables.
#
# Note: with the single-origin setup in vercel.json (API rewritten under
# /api and /auth on the same domain), VITE_API_BASE_URL can usually be left
# empty/relative in production — the client already calls relative
# /api/... paths. Only set it if the API is deployed on a different origin.
VITE_API_BASE_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>