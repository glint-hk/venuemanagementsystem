# Server environment variables. Copy to .env for local dev.
# Never commit a real .env file — only this .env.example is tracked in git.

# PostgreSQL connection string. The exclusion constraint and audit_log
# immutability (prisma/migrations/*_add_concurrency_guarantee) require
# PostgreSQL locally too -- SQLite cannot express either guarantee.
#
# Two roles are involved: migrations run as an elevated/owner role (e.g.
# postgres); the running server should connect as the least-privilege
# "app_user" role that migration creates, which has no UPDATE/DELETE on
# audit_log. Point DATABASE_URL at app_user for `npm run dev`/`start`, and
# use an elevated connection string only when running `prisma migrate`.
DATABASE_URL=postgresql://app_user:<APP_USER_PASSWORD>@localhost:5432/<DB_NAME>

# Signing secret for JWT access/refresh tokens.
JWT_SECRET=<GENERATE_A_STRONG_RANDOM_SECRET>

# Google OAuth client ID, restricted server-side to the institutional domain.
GOOGLE_OAUTH_CLIENT_ID=<YOUR_GOOGLE_OAUTH_CLIENT_ID>

# SMTP config for the notification outbox worker.
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=<SMTP_PORT>
SMTP_USER=<SMTP_USER>
SMTP_PASS=<SMTP_PASSWORD>

# Port Express listens on.
PORT=4000

# Allowed CORS origin for local dev (client and server run on different ports before build).
CLIENT_ORIGIN=http://localhost:5173

# Optional subpath for reverse-proxy mounting, e.g. "/venue-booking".
BASE_PATH=
