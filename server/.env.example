# Server environment variables.
# Local dev: copy to server/.env and fill in.
# Vercel: set these under Project Settings → Environment Variables instead
# (do not commit real values, and do not upload a filled-in .env anywhere).

# --- Database (Postgres via Prisma) ---------------------------------------
# schema.prisma is untouched — it just reads DATABASE_URL. Point it at
# Supabase or Neon by swapping this one value:
#
# Supabase (pooled, use this one as DATABASE_URL for the deployed app —
# serverless functions open many short-lived connections, so you want the
# pgbouncer pooler on port 6543, not a direct connection):
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
#
# Neon (pooled — hostname contains "-pooler"):
#   postgresql://<user>:<password>@ep-xxxx-pooler.<region>.aws.neon.tech/<db>?sslmode=require
#
# For running `prisma migrate deploy` (from your machine or CI), use the
# DIRECT (non-pooled) connection string instead, temporarily, in your local
# .env or CI env — not the pooled one:
#   Supabase direct: swap :6543 for :5432 and drop ?pgbouncer=true
#   Neon direct: drop "-pooler" from the hostname
DATABASE_URL=<DATABASE_URL>

# --- Auth -------------------------------------------------------------------
# Long random string for signing JWTs. Generate with: openssl rand -base64 48
#JWT_SECRET=<JWT_SECRET>

# Google OAuth client, restricted server-side to the institutional domain.
GOOGLE_OAUTH_CLIENT_ID=<GOOGLE_OAUTH_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>

# --- Notifications (not wired up in code yet — optional for now) -----------
SMTP_HOST=<SMTP_HOST>
SMTP_PORT=<SMTP_PORT>
SMTP_USER=<SMTP_USER>
SMTP_PASS=<SMTP_PASSWORD>

# --- Server -----------------------------------------------------------------
# PORT is only used for local `npm run dev`/`start` — Vercel ignores it and
# assigns its own port to the function.
PORT=8000

# On Vercel, set this to your deployed domain (or your custom domain).
# Locally, keep it pointed at the Vite dev server.
CLIENT_ORIGIN=https://venuemanagementsystem.vercel.app

# Optional subpath for reverse-proxy mounting, e.g. "/venue-booking".
# Leave unset on Vercel (app is served from the domain root).
#BASE_PATH=